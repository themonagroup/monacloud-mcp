{
  "name": "monacloud-mcp",
  "version": "0.10.11",
  "description": "MCP server for MONA Cloud — deploy apps (Vercel alternative), Supabase-compatible Postgres/Auth/Storage bases (Supabase alternative), VND wallet, MONA Pay & Mail — for AI agents (Claude, Cursor, Codex) in Vietnam.",
  "license": "MIT",
  "homepage": "https://monacloud.vn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themonagroup/monacloud-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/themonagroup/monacloud-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mona-cloud",
    "mona-base",
    "supabase-alternative",
    "vercel-alternative",
    "vietnam",
    "vnd",
    "ai-agent",
    "claude",
    "cursor",
    "codex",
    "postgres",
    "deploy",
    "vibecoder",
    "domain",
    "domains",
    "ten-mien",
    "vn-domain",
    "vietnam-domain",
    "buy-domain",
    "domain-registrar",
    "vercel-domains-alternative",
    "gemini"
  ],
  "type": "module",
  "bin": {
    "monacloud-mcp": "dist/index.js",
    "monacloud-mcp-remote": "dist/remote-cli.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": [
    "dist",
    "docs",
    "README.md",
    "STATUS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "mcpb": "node scripts/build-mcpb.mjs",
    "test": "npm run build && node support/test.mjs",
    "start": "node dist/index.js",
    "start:remote": "node dist/remote-cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "monapay-mcp": "^0.5.5",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  },
  "mcpName": "vn.monacloud/monacloud-mcp"
}
