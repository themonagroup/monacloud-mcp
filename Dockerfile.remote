# dist/ build sẵn trên máy dev (tsc 7 native không có gói linux trong lockfile) → image chỉ cài deps prod.
FROM node:22-alpine
WORKDIR /app
RUN addgroup -S mcp && adduser -S -G mcp mcp
COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY dist ./dist
RUN mkdir -p /app/data && chown -R mcp:mcp /app/data
USER mcp
EXPOSE 8765
CMD ["node", "dist/remote-cli.js"]
